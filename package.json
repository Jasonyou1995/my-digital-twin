{
  "name": "my-digital-twin",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --watch",
    "dev": "npm run build:css && wrangler pages dev",
    "deploy": "npm run build:css && wrangler pages deploy"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "workerd@1.20261104.1": true
  }
}
